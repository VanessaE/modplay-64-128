; gui.xa - CMMS 64 v2.0.0
 
; This file comprises pretty much everything needed to create the GUI.  Think
; of this file as a sort of a tool kit, as QT or GTK+ are to some open-source
; PC applications.

; This first routine simply blanks out an area of the screen, fills it with a
; solid color (either hires background or multicolor ColorRAM value), and fills
; the corresponding region of the widgets map with zeroes.

; Enter with .XY = Upper-left corner of filled area, FillSize[XY] = X/Y size,
; and .A = Zero Page address of color to use (see variables.xa).

+FillArea	stx FillStartX	; We'll need backups of these.
		sty FillStartY
		sta fc1+1	; This translates color address into actual
fc1		lda $00		; color to fill with
		sta FillColor
		lda FillSizeY	; We use FillSize[XY] as column/line counters
		sta tempbyte1

; First, blank out the bitmap part

linecount	ldx FillSizeX
		ldy tempbyte1
		lda BitmapLines,y
		sta tempword1
		lda BitmapLines+25,y
		sta tempword1+1
		lda VideoMode	; since 0 is used to fill hires and $FF to fill
				; multi, we can directly use this flag's value
				; as a fill value.
				
fill_line	ldy #7
fillchar	sta (tempword1),y		
		dey
		bpl fillchar
		clc
		lda tempword1
		adc #8
		sta tempword1
		bcc dec1
		inc tempword1+1
dec1		dex
		bpl fill_line
		dec tempbyte1
		bpl linecount

; Next, fill the appropriate region of either Color RAM (Multicolor Mode) or
; Video Matrix (Hires Mode) with the desired color.

		bit VideoMode
		bne multicolor

		lda FillSizeY	; We use FillSize[XY] as column/line counters
		sta tempbyte1
		ldx tempbyte1	; X=Number of lines to fill
		lda VMLines,y	; Start address...
		sta tempword1
		lda VMLines+25,y
		sta tempword1+1

linecount2	ldy FillSizeX	; Y=Number of columns to fill
		lda FillColor		

fillbyte1	sta (tempword1),y
		dey
		bpl fillbyte1
		clc
		lda tempword1
		adc #40		; Adding 40 moves to the next row
		sta tempword1
		bcc dec2
		inc tempword1+1
dec2		dex
		bpl linecount2
		bmi fill_widgetmap

multicolor	lda FillSizeY	; We use FillSize[XY] as column/line counters
		sta tempbyte1
		ldx tempbyte1	; X=Number of lines to fill
		lda ColorLines,y ; Start address...
		sta tempword1
		lda ColorLines+25,y
		sta tempword1+1

linecount3	ldy FillSizeX	; Y=Number of columns to fill
		lda FillColor		

fillbyte2	sta (tempword1),y
		dey
		bpl fillbyte2
		clc
		lda tempword1
		adc #40
		sta tempword1
		bcc dec3
		inc tempword1+1
dec3		dex
		bpl linecount3

fill_widgetmap	lda FillSizeY	; We use FillSize[XY] as column/line counters
		sta tempbyte1
		ldx tempbyte1	; X=Number of lines to fill
		lda WidgetMapLines,y ; Start address...
		sta tempword1
		lda WidgetMapLines+25,y
		sta tempword1+1

linecount4	ldy FillSizeX	; Y=Number of columns to fill
		lda #0		; We always fill widget map with 0's

fillbyte3	sta (tempword1),y
		dey
		bpl fillbyte3
		clc
		lda tempword1
		adc #40		; like screen memory, widget map is a 1000-
		sta tempword1	; byte matrix, with the same type of layout.
		bcc dec4
		inc tempword1+1
dec4		dex
		bpl linecount4
		rts

