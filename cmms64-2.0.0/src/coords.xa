; coords.xa - CMMS 64 v2.0.0

; This subroutine converts mouse coordinates into color-cell coordinates
; (Used by the UI routines to detect what widget sits under the pointer, if
; any)
;
; We do this by simply dividing the mouse {X,Y} coordinates by 8.

+TranslateCoords
	lda Coordinates+1	; First, the X coordinate
	sta tempbyte1
	lda Coordinates
	lsr tempbyte1		; each lsr/ror pair right-shifts the two-byte
	ror			; value by one bit, in effect dividing it by
	lsr tempbyte1		; two.
	ror
	lsr tempbyte1
	ror
	sta CellCoords

	lda Coordinates+3	; Now do the X coordinate in the same way.
	sta tempbyte1
	lda Coordinates+2
	lsr tempbyte1
	ror
	lsr tempbyte1
	ror
	lsr tempbyte1
	ror
	sta CellCoords+1
	rts
